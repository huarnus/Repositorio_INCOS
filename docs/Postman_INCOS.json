{
  "info": {
    "name": "Repositorio INCOS REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api",
      "value": "http://localhost/repositorio_api/api/index.php?route=/v1"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "carrera_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Comprobar API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/health"
      }
    },
    {
      "name": "2. Obtener CSRF y cookie",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"csrf\", pm.response.json().data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{api}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\": \"{{usuario}}\", \"contraseña\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"token\", pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Mi usuario",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{api}}/auth/me"
      }
    },
    {
      "name": "5. Listar carreras",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/carreras"
      }
    },
    {
      "name": "6. Crear carrera de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{api}}/carreras",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre_carrera\": \"PRUEBA API\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"carrera_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Modificar carrera de prueba",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{api}}/carreras/{{carrera_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre_carrera\": \"PRUEBA API EDITADA\"}"
        }
      }
    },
    {
      "name": "8. Eliminar solo la carrera de prueba",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{api}}/carreras/{{carrera_id}}"
      }
    }
  ]
}